/* ── Login / Signup ─────────────────────────────────────────────── */

#login-form, #signup-form {
    width: 50;
    padding: 2 4;
}

#title {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#login_btn {
    height: 3;
    background: $success;
    color: $background;
    content-align: center middle;
    margin: 0 1;
}

#to_signup {
    height: 3;
    content-align: center middle;
    margin: 1 1;
}

Input { margin-bottom: 1; }

Button {
    width: 100%;
    content-align: center middle;
    text-style: bold;
}

/* ── Sidebar ────────────────────────────────────────────────────── */

#sidebar {
    width: 30;
    background: $surface;
    border-right: vkey $primary;
    padding: 1 1 1 1;
    scrollbar-gutter: stable;
}

#sidebar-title {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
    color: $accent;
}

#sidebar Button {
    width: 100%;
    height: 3;
    margin-left: 0;
    margin-bottom: 1;
    border: none;
    text-style: bold;
    content-align: center middle;
}

#sidebar Button:focus {
    outline: none;
    background: $accent;
    color: $background;
    text-style: bold;
}

#btn_room_mgmt {
    background: $primary;
    color: $background;
}

#btn_private {
    background: $success;
    color: $background;
}

/* ── Rooms list ─────────────────────────────────────────────────── */

#rooms-list {
    height: 1fr;
    overflow-y: scroll;
    scrollbar-size: 0 0;
}

.room-link {
    width: 100%;
    height: 3;
    background: transparent;
    border: none;
    content-align: left middle;
    padding-left: 2;
}

.room-link:hover {
    background: $primary 30%;
    text-style: bold;
}

.room-link.active {
    background: $primary;
    color: $background;
    text-style: bold;
}

.empty-msg {
    color: $text-disabled;
    text-align: center;
    margin-top: 1;
}

/* ── Chat area ──────────────────────────────────────────────────── */

/* FIX: was defined twice — merged into one */
#chat-view {
    display: none;
    width: 1fr;
    height: 100%;
}

/* FIX: was defined twice — merged into one */
#empty-view {
    width: 1fr;
    height: 100%;
    content-align: center middle;
    color: $text-disabled;
}

#chat_log {
    height: 1fr;
    background: $surface;
    border-bottom: solid $primary;
    padding: 1;

    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-color: $primary 30%;
}

#chat_log:hover {
    scrollbar-color: $primary 80%;
}

.tk-light #chat_log {
    scrollbar-color: $primary 15%;
}

.tk-light #chat_log:hover {
    scrollbar-color: $primary 50%;
}

#chat_input {
    height: 3;
    margin: 1;
    border: tall $primary;
}

#chat-container {
    width: 1fr;
    height: 100%;
}

#chat-area {
    width: 1fr;
    height: 100%;
}

#screen-body {
    height: 1fr;
}

Screen {
    border: none;
}

/* ── RoomActionScreen modal ─────────────────────────────────────── */

RoomActionScreen {
    align: center middle;
}

#room-action-dialog {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    align: center middle;
}

#action-buttons-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: 1fr 1fr;
    height: 3;
    margin: 1 0;
}

#action-buttons-grid Button {
    width: 100%;
}

/* ── SecurityScreen modal ───────────────────────────────────────── */

SecurityScreen {
    align: center middle;
}

#security-dialog {
    width: 55;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#security-label {
    text-style: bold;
    margin-bottom: 1;
}

#security-hint {
    margin-bottom: 1;
}

/* ── PrivateWhisperPromptScreen modal ───────────────────────────── */

PrivateWhisperPromptScreen {
    align: center middle;
}

#action-button-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: 1fr 1fr;
    height: 3;
    margin: 1 0;
}

#action-button-grid Button {
    width: 100%;
}

#action-buttons-grid-3way{
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    grid-columns: 1fr 1fr 1fr;
    height: 3;
    margin: 1 0;
}

/* ── JoinRoomScreen modal (legacy) ──────────────────────────────── */

JoinRoomScreen {
    align: center middle;
}

#join-dialog {
    width: 40;
    height: 15;
    border: thick $primary;
    background: $surface;
    padding: 1;
}

#room-id-input {
    margin: 1 0;
}

#join-dialog Button {
    width: 100%;
    margin-bottom: 1;
}
